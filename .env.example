NODE_ENV=development
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://wallet:wallet@localhost:5432/wallet
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h

INITIAL_WALLET_BALANCE=10000000
RECEIPT_THRESHOLD=5000000
RECEIPT_JOB_ATTEMPTS=5
RECEIPT_JOB_BACKOFF_MS=2000
WORKER_CONCURRENCY=5

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=receipts
MINIO_REGION=us-east-1
MINIO_PUBLIC_URL=http://localhost:9000
RECEIPT_URL_EXPIRY_SECONDS=604800

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=System Administrator
SEED_DEMO_USERS=true
